{
  "manifest_version": 3,
  "name": "Pop Quiz for Google Slides: Live Team Quiz and Polls",
  "version": "0.8.1",
  "description": "Live quiz, polls and leaderboards inside your Google Slides deck. Players join by phone with a QR code. No app or sign-up. Free.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "https://docs.google.com/presentation/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pop Quiz",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/presentation/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://docs.google.com/presentation/*"
      ],
      "js": [
        "ext/notes-keys.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ext/*",
        "stage/*",
        "shared/*",
        "vendor/*"
      ],
      "matches": [
        "https://docs.google.com/*"
      ]
    }
  ],
  "short_name": "Pop Quiz"
}
